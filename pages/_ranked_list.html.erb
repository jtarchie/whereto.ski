<% days = snow_days(resorts.first).map { |d| d[:date] } %>

<div data-ranked-section>
  <% if heading %>
    <h2 class="mb-2"><%= heading %></h2>
  <% end %>

  <table class="ranked" data-ranked>
    <caption class="sr-only">
      Resorts ranked by snow. Sort buttons are in the column headers.
    </caption>

    <thead>
      <tr>
        <th scope="col" class="rank"><span class="sr-only">Rank</span></th>

        <th scope="col" class="who" data-s="day" aria-sort="none">
          <div class="who-row">
            <span>Resort</span>

            <div class="days">
              <% days.each do |date| %>
                <button
                  type="button"
                  data-sort="<%= date.iso8601 %>"
                  aria-label="Sort by snow on <%= short_date(date) %>"
                >
                  <%= date.strftime("%a")[0] %>
                  <br>
                  <%= date.day %>
                </button>
              <% end %>
            </div>
          </div>
        </th>

        <% ranked_columns.each do |col| %>
          <th
            scope="col"
            class="num"
            data-s="<%= col[:key] %>"
            aria-sort="<%= col[:key] == "7d" ? "descending" : "none" %>"
          >
            <button type="button" data-sort="<%= col[:key] %>">
              <span class="lg:hidden" aria-hidden="true"><%= col[:short] %></span><span class="max-lg:sr-only"><%= col[:label] %></span>
            </button>
          </th>
        <% end %>

        <th scope="col" class="next">
          Next<span class="max-md:sr-only"> snow</span>
        </th>
      </tr>
    </thead>

    <tbody>
      <% resorts.each_with_index do |resort, index| %>
        <% summary = snow_summary(resort)
        upcoming = next_snow_day(resort) %>

        <tr data-has-snow="<%= summary[:next_16d].positive? %>">
          <td class="rank"><%= index + 1 %></td>

          <td class="who">
            <div class="who-row">
              <div>
                <a href="/resorts/<%= resort.slug %>"><%= h resort.name %></a>

                <% line = place.map { |part| resort.public_send(part) }.compact.uniq %>

                <% if line.any? %>
                  <span class="place"><%= h line.join(" · ") %></span>
                <% end %>
              </div>

              <div class="strip" aria-hidden="true">
                <% snow_days(resort).each_with_index do |day, column| %>
                  <% next unless day[:inches].positive? %>

                  <i
                    data-v="<%= day[:inches].round(2) %>"
                    class="bg-mark-<%= snow_level(day[:inches]) %>"
                    style="grid-column:<%= column + 1 %>;height:<%= (day[:inches] / 12.0 * 100).round.clamp(8, 100) %>%"
                  ></i>
                <% end %>
              </div>
            </div>
          </td>

          <% ranked_columns.each do |col| %>
            <% inches = summary[col[:field]]
            level = snow_level(inches) %>

            <td
              data-s="<%= col[:key] %>"
              class="<%= snow_cell_class(inches, zero: nil) %>"
            >
              <% if level.zero? %>
                –
              <% else %>
                <%= snow_value(inches) %>
              <% end %>
            </td>
          <% end %>

          <td class="next">
            <%= upcoming ? upcoming_day_name(upcoming[:date], days) : "–" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
