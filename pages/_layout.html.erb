<!doctype html>

<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="description" content="<%= description %>">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    >

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">

    <meta
      property="og:url"
      content="https://whereto.ski<%= defined?(page_url) ? page_url : '' %>"
    >

    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">

    <meta
      property="og:image"
      content="<%= defined?(og_image_url) ? og_image_url : 'https://whereto.ski/assets/favicon/android-icon-192x192.png' %>"
    >

    <meta property="og:image:alt" content="<%= title %>">
    <meta property="og:site_name" content="Where To Ski">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">

    <meta
      name="twitter:url"
      content="https://whereto.ski<%= defined?(page_url) ? page_url : '' %>"
    >

    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">

    <meta
      name="twitter:image"
      content="<%= defined?(og_image_url) ? og_image_url : 'https://whereto.ski/assets/favicon/android-icon-192x192.png' %>"
    >

    <meta name="twitter:image:alt" content="<%= title %>">

    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="f7b15640-326b-4ea5-a2f3-912fdf4b1d35"
    ></script>

    <link rel="stylesheet" href="/assets/main.css">

    <link
      rel="apple-touch-icon"
      sizes="57x57"
      href="/assets/favicon/apple-icon-57x57.png"
    >

    <link
      rel="apple-touch-icon"
      sizes="60x60"
      href="/assets/favicon/apple-icon-60x60.png"
    >

    <link
      rel="apple-touch-icon"
      sizes="72x72"
      href="/assets/favicon/apple-icon-72x72.png"
    >

    <link
      rel="apple-touch-icon"
      sizes="76x76"
      href="/assets/favicon/apple-icon-76x76.png"
    >

    <link
      rel="apple-touch-icon"
      sizes="114x114"
      href="/assets/favicon/apple-icon-114x114.png"
    >

    <link
      rel="apple-touch-icon"
      sizes="120x120"
      href="/assets/favicon/apple-icon-120x120.png"
    >

    <link
      rel="apple-touch-icon"
      sizes="144x144"
      href="/assets/favicon/apple-icon-144x144.png"
    >

    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href="/assets/favicon/apple-icon-152x152.png"
    >

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/favicon/apple-icon-180x180.png"
    >

    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/assets/favicon/android-icon-192x192.png"
    >

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicon/favicon-32x32.png"
    >

    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/assets/favicon/favicon-96x96.png"
    >

    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicon/favicon-16x16.png"
    >

    <link rel="manifest" href="/assets/favicon/manifest.json">

    <% if defined?(page_url) %>
      <link rel="canonical" href="https://whereto.ski<%= page_url %>">
    <% end %>

    <meta name="color-scheme" content="light dark">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">

    <meta
      name="theme-color"
      content="#fbfcfd"
      media="(prefers-color-scheme: light)"
    >

    <meta
      name="theme-color"
      content="#121518"
      media="(prefers-color-scheme: dark)"
    >

    <title>Where To Ski &raquo; <%= title %></title>
  </head>

  <body class="flex min-h-dvh flex-col">
    <header class="border-b bg-canvas">
      <div class="mx-auto flex h-14 max-w-page items-center justify-between gap-4 px-4">
        <a href="/" class="text-md font-semibold tracking-tight no-underline">
          Where To Ski
        </a>

        <div class="flex items-center gap-1">
          <button
            id="search-button"
            type="button"
            class="
              icon-button md:w-64 md:justify-between md:border md:px-3
              md:text-sm
            "
            aria-label="Search"
            aria-keyshortcuts="/ Control+K Meta+K"
          >
            <span class="hidden md:inline">Search resorts</span>

            <svg
              aria-hidden="true"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              ></path>
            </svg>
          </button>

          <button
            type="button"
            class="icon-button"
            onclick="settings_modal.showModal()"
            aria-label="Settings"
          >
            <svg
              aria-hidden="true"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path>

              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-page grow px-4 py-6"><%= content %></main>

    <footer class="border-t text-sm text-ink-2">
      <div class="mx-auto flex max-w-page flex-col gap-3 px-4 py-6">
        <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-2">
          <a href="/about">About</a>
          <a href="mailto:hello@whereto.ski">Contact</a>
          <a href="https://www.buymeacoffee.com/jtarchie">Support</a>
          <a href="https://github.com/jtarchie/followthesnow">GitHub</a>
        </nav>

        <p>
          Forecasts by <a href="https://open-meteo.com/">Open-Meteo</a> (CC BY
          4.0). Resort data from
          <a href="https://openskimap.org">OpenSkiMap</a>, ©
          <a href="https://www.openstreetmap.org/copyright"> OpenStreetMap contributors </a>
          (ODbL).
        </p>

        <p>Updated <%= current_timestamp %></p>
      </div>
    </footer>

    <dialog id="settings_modal" class="dialog" aria-labelledby="settings-title">
      <div class="dialog-box">
        <div class="flex items-center justify-between">
          <h2 id="settings-title">Settings</h2>

          <form method="dialog">
            <button type="submit" class="icon-button" aria-label="Close">
              <svg
                aria-hidden="true"
                class="size-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
              </svg>
            </button>
          </form>
        </div>

        <div class="divide-y">
          <label
            for="unit-toggle"
            class="
              flex min-h-(--size-hit) items-center justify-between gap-4
              py-2
            "
          >
            <span>
              Metric units
              <span class="block text-sm text-ink-2"> °C, cm, km/h, m instead of °F, in, mph, ft </span>
            </span>

            <input type="checkbox" id="unit-toggle" class="switch">
          </label>

          <label
            for="tz-select"
            class="
              flex min-h-(--size-hit) items-center justify-between gap-4
              py-2
            "
          >
            <span>
              Time zone
              <span class="block text-sm text-ink-2"> For hourly forecasts and update times </span>
            </span>

            <select id="tz-select" class="input w-44 text-sm">
              <option value="auto">Auto</option>
              <option value="resort">Resort local</option>
            </select>
          </label>

          <label
            for="filter-snow-toggle"
            class="
              flex min-h-(--size-hit) items-center justify-between gap-4
              py-2
            "
          >
            <span>Only show resorts with snow</span>
            <input type="checkbox" id="filter-snow-toggle" class="switch">
          </label>
        </div>
      </div>
    </dialog>

    <dialog
      id="search-modal"
      class="dialog md:mt-[12vh]"
      aria-labelledby="search-title"
    >
      <div class="dialog-box">
        <div class="flex items-center justify-between">
          <h2 id="search-title">Search</h2>

          <form method="dialog">
            <button type="submit" class="icon-button" aria-label="Close">
              <svg
                aria-hidden="true"
                class="size-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
              </svg>
            </button>
          </form>
        </div>

        <input
          type="search"
          id="search-input"
          placeholder="Resort, town, region or country"
          class="input"
          autocomplete="off"
          enterkeyhint="search"
          aria-label="Search for countries, regions, or resorts"
        >

        <p
          id="search-loading"
          role="status"
          class="hidden py-6 text-center text-ink-2"
        >
          Loading…
        </p>

        <p
          id="search-error"
          role="alert"
          class="hidden py-6 text-center text-error"
        >
          Search couldn't load. Check your connection and try again.
        </p>

        <div id="search-results" class="min-h-0 overflow-y-auto"></div>

        <p
          id="search-empty"
          role="status"
          class="hidden py-6 text-center text-ink-2"
        >
          No matches. Try a town or region name.
        </p>
      </div>
    </dialog>

    <script src="/assets/main.js"></script>
  </body>
</html>
