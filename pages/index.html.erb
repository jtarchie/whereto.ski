<% list = ranked(resorts)
  snowing = list.count { |r| snow_summary(r)[:next_7d].positive? } %>

<!--
  ---
  title: Where To Ski — snow forecasts for ski resorts worldwide
  description: 'Snow forecasts for <%= list.size %> ski resorts worldwide: <%= snowing %> with snow in the next 7 days. Updated daily.'
  page_url: '/'
  ---
-->

<%= partial("scope_header", title: "Where's the snow", scope: "World", list: list, alternative: nil) %>

<h2 class="mb-2">Top 25 resorts</h2>

<%= partial("ranked_list", resorts: list.first(25), place: %i[region_name country_name]) %>

<%= partial(
  "area_table",
  id: "countries-heading",
  heading: "Countries",
  noun: "Country",
  rows: area_rows(resorts_by_countries),
  href: ->(name) { "/countries/#{name.to_url}" }
) %>
