<% list = ranked(resorts) %>

<!--
  ---
  title: Where To Ski — snow forecasts for ski resorts worldwide
  description: '<%= h scope_description(list, "worldwide") %>'
  page_url: '/'
  ---
-->

<%= partial("scope_header", title: "Where's the snow", scope: "World", list: list, alternative: nil) %>

<%= partial("ranked_list", heading: "Top 25 resorts", resorts: list.first(25), place: %i[region_name country_name]) %>

<%= partial(
  "area_table",
  id: "countries-heading",
  heading: "Countries",
  noun: "Country",
  rows: area_rows(resorts_by_countries),
  href: ->(name) { "/countries/#{name.to_url}" }
) %>

<%= partial("map", kind: "overview", country: nil, region: nil, resort: nil) %>
