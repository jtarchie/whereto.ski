<% country = resorts.first.country_name
  list = ranked(resorts)
  snowing = list.count { |r| snow_summary(r)[:next_7d].positive? }
  sibling = snowiest_area(regions_of(country), except: state) %>

<!--
  ---
  title: '<%= h state %> snow forecast'
  description: 'Snow forecast for ski resorts in <%= h state %>, <%= h country %>: <%= snowing %> of <%= list.size %> <%= "resort".pluralize(list.size) %> with snow in the next 7 days.'
  page_url: '/states/<%= state.to_url %>'
  ---
-->

<%= breadcrumbs([["World", "/"], [country, "/countries/#{country.to_url}"], [state, nil]]) %>

<%= partial(
  "scope_header",
  title: state,
  scope: state,
  list: list,
  alternative: sibling && [sibling, "/states/#{sibling.to_url}"]
) %>

<%= partial("ranked_list", resorts: list, place: %i[locality]) %>

<%= partial("map", kind: "overview", country: country, region: state, resort: nil) %>
