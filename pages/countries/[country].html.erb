<% all = ranked(resorts_for_country(country))
  small = small_country?(country)
  list = small ? all : all.first(25)
  snowing = all.count { |r| snow_summary(r)[:next_7d].positive? }
  other = snowiest_area(resorts_by_countries, except: country) %>

<!--
  ---
  title: '<%= h country %> snow forecast'
  description: 'Snow forecast for ski resorts in <%= h country %>: <%= snowing %> of <%= all.size %> <%= "resort".pluralize(all.size) %> with snow in the next 7 days.'
  page_url: '/countries/<%= country.to_url %>'
  ---
-->

<%= breadcrumbs([["World", "/"], [country, nil]]) %>

<%= partial(
  "scope_header",
  title: country,
  scope: country,
  list: all,
  alternative: other && [other, "/countries/#{other.to_url}"]
) %>

<% unless small %>
  <h2 class="mb-2">Top 25 resorts</h2>
<% end %>

<%= partial("ranked_list", resorts: list, place: small ? %i[locality region_name] : %i[region_name]) %>

<% unless small %>
  <%= partial(
    "area_table",
    id: "regions-heading",
    heading: "Regions",
    noun: "Region",
    rows: area_rows(regions_of(country)),
    href: ->(name) { "/states/#{name.to_url}" }
  ) %>
<% end %>

<%= partial("map", kind: "overview", country: country, region: nil, resort: nil) %>
