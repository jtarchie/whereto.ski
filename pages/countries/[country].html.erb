<% all = ranked(resorts_for_country(country))
  small = small_country?(country)
  list = small ? all : all.first(25)
  other = snowiest_area(resorts_by_countries, except: country) %>

<!--
  ---
  title: '<%= h country %> snow forecast'
  description: '<%= h scope_description(all, "in #{country}") %>'
  page_url: '/countries/<%= country.to_url %>'
  ---
-->

<%= breadcrumbs([["World", "/"], [country, nil]]) %>

<%= partial(
  "scope_header",
  title: country,
  scope: country,
  list: all,
  alternative: other && [other, "/countries/#{other.to_url}"]
) %>

<%= partial("ranked_list", heading: (small ? nil : "Top 25 resorts"), resorts: list, place: small ? %i[locality region_name] : %i[region_name]) %>

<% unless small %>
  <%= partial(
    "area_table",
    id: "regions-heading",
    heading: "Regions",
    noun: "Region",
    rows: area_rows(regions_of(country)),
    href: ->(name) { "/states/#{name.to_url}" }
  ) %>
<% end %>

<%= partial("map", kind: "overview", country: country, region: nil, resort: nil) %>
